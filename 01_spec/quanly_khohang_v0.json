      ],
      "title": "Mã phiếu kho dài đúng 32 ký tự và dài 100 ký tự",
      "preconditions": "parse_voucher_id sinh từ đặc tả (v0: buffer 32 byte, Loi=buffer-overflow) - M1 Thọ",
      "steps": [
