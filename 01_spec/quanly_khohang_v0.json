  "arithmetic_checks": [
    {
      "name": "buffer_capacity_check",
      "int_vars": [
        "cap",
        "input_len"
      ],
      "condition": "cap == 32 and input_len >= cap",
      "overflow_expr": "input_len - cap"
    },
    {
      "name": "token_index_check",
      "int_vars": [
        "token_count",
        "field_idx"
      ],
      "condition": "token_count > 0 and (field_idx < 0 or field_idx >= token_count)",
      "overflow_expr": "field_idx - token_count"
    },
    {
      "name": "heap_alloc_bytes",
      "int_vars": [
        "new_capacity",
        "item_size"
      ],
      "condition": "new_capacity >= 1 and item_size == 48 and new_capacity * item_size > 2147483647",
      "overflow_expr": "new_capacity * item_size"
    },
    {
      "name": "stock_addition_overflow",
      "int_vars": [
        "old_stock",
        "added_quantity"
      ],
      "condition": "old_stock >= 0 and old_stock <= 2147483647 and added_quantity >= 1 and added_quantity <= 2147483647 and old_stock + added_quantity > 2147483647",
      "overflow_expr": "old_stock + added_quantity"
    },
    {
      "name": "negative_quantity_check",
      "int_vars": [
        "added_quantity"
      ],
      "condition": "added_quantity < 0",
      "overflow_expr": "added_quantity"
    },
    {
      "name": "price_multiplication_overflow",
      "int_vars": [
        "base_price",
        "rate"
      ],
      "condition": "base_price > 0 and rate > 1 and base_price * rate > 2147483647",
      "overflow_expr": "base_price * rate"
    }
  ],
