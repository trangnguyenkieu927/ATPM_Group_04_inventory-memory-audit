  "arithmetic_checks": [
    {
      "name": "stock_addition_overflow",
      "int_vars": [
        "current_stock",
        "added_quantity"
      ],
      "condition": "current_stock >= 0 and current_stock <= 2147483647 and added_quantity >= 1 and added_quantity <= 2147483647 and current_stock + added_quantity > 2147483647",
      "overflow_expr": "current_stock + added_quantity"
    },
    {
      "name": "heap_alloc_bytes",
      "int_vars": [
        "new_capacity",
        "item_size"
      ],
      "condition": "new_capacity >= 1 and item_size == 48 and new_capacity * item_size > 2147483647",
      "overflow_expr": "new_capacity * item_size"
    },
    {
      "name": "line_amount_mul",
      "int_vars": [
        "price",
        "qty"
      ],
      "condition": "price >= 0 and price <= 50000000 and qty >= 1 and qty <= 1000 and price * qty > 2147483647",
      "overflow_expr": "price * qty"
    },
    {
      "name": "accumulated_total",
      "int_vars": [
        "total_before",
        "line_total"
      ],
      "condition": "total_before >= 0 and total_before <= 2147483647 and line_total >= 0 and line_total <= 50000000 and total_before + line_total > 2147483647",
      "overflow_expr": "total_before + line_total"
    },
    {
      "name": "negative_quantity_check",
      "int_vars": [
        "added_quantity"
      ],
      "condition": "added_quantity < 0",
      "overflow_expr": "added_quantity"
    },
    {
      "name": "negative_total",
      "int_vars": [
        "subtotal",
        "discount"
      ],
      "condition": "subtotal >= 0 and subtotal <= 2000000000 and discount + 2000000000 >= 0 and discount <= 2000000000 and subtotal - discount < 0",
      "overflow_expr": "subtotal - discount"
    }
  ],
  "test_cases": [
