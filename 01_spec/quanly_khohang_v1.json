  "functions": [
    {
      "name": "ingest_raw_line",
      "language": "c",
      "kind": "buffer_copy",
      "params": [
        "dst",
        "cap",
        "raw_line"
      ],
      "buffer_size": 32
    },
    {
      "name": "get_token_field",
      "language": "c",
      "kind": "array_read",
      "params": [
        "token_offsets",
        "token_count",
        "field_idx"
      ]
    },
    {
      "name": "expand_stock_items",
      "language": "c",
      "kind": "alloc_release",
      "params": [
        "list",
        "new_capacity"
      ],
      "buffer_size": 16
    },
    {
      "name": "release_stock_items",
      "language": "c",
      "kind": "alloc_release",
      "params": [
        "list"
      ],
      "buffer_size": 16
    },
    {
      "name": "update_stock_quantity",
      "language": "c",
      "kind": "arithmetic",
      "params": [
        "current_stock",
        "added_quantity"
      ]
    },
    {
      "name": "scale_product_price",
      "language": "c",
      "kind": "arithmetic",
      "params": [
        "base_price",
        "rate"
      ]
    },
    {
      "name": "calc_batch_capacity",
      "language": "python",
      "kind": "divide",
      "params": [
        "total_items",
        "batch_size"
      ]
    }
  ],
  "arithmetic_checks": [
    {
      "name": "stock_addition_overflow",
      "int_vars": [
        "current_stock",
        "added_quantity"
      ],
      "condition": "current_stock >= 0 and added_quantity >= 1 and current_stock + added_quantity > 2147483647",
      "overflow_expr": "current_stock + added_quantity"
    },
    {
      "name": "heap_alloc_bytes",
      "int_vars": [
        "new_capacity",
        "item_size"
      ],
      "condition": "new_capacity >= 1 and item_size == 48 and new_capacity * item_size > 2147483647",
      "overflow_expr": "new_capacity * item_size"
    },
    {
      "name": "price_multiplication_overflow",
      "int_vars": [
        "base_price",
        "rate"
      ],
      "condition": "base_price > 0 and rate > 1 and base_price * rate > 2147483647",
      "overflow_expr": "base_price * rate"
    },
    {
      "name": "negative_quantity_check",
      "int_vars": [
        "added_quantity"
      ],
      "condition": "added_quantity < 0",
      "overflow_expr": "added_quantity"
    }
  ],
  "test_cases": [
    {
      "id": "TC-01",
      "requirement_ids": [
        "REQ-01",
        "CON-01"
      ],
      "title": "H1: Nạp chuỗi 32 và 33 byte bị từ chối an toàn",
      "preconditions": "ingest_raw_line_v1 có rào chắn kiểm tra len < 32 - M1 Thọ",
      "steps": [
        "Gọi ingest_raw_line_v1 với chuỗi dài 32 và 33 ký tự"
      ],
      "expected_result": "Hàm từ chối xử lý, trả về mã lỗi an toàn -2, 0 byte bị ghi đè",
      "priority": "HIGH"
    },
    {
      "id": "TC-02",
      "requirement_ids": [
        "REQ-02",
        "CON-01"
      ],
      "title": "H1: Nạp chuỗi hợp lệ 31 byte thành công",
      "preconditions": "char buffer[32], cap = 32, chuỗi dài 31 ký tự - M1 Thọ",
      "steps": [
        "Gọi ingest_raw_line_v1 với chuỗi 31 byte"
      ],
      "expected_result": "Trả về 31, sao chép thành công và kết thúc bằng '\\0'",
      "priority": "HIGH"
    },
    {
      "id": "TC-03",
      "requirement_ids": [
        "REQ-03",
        "CON-02"
      ],
      "title": "H2: Đọc token ngoài biên bị từ chối có kiểm soát",
      "preconditions": "token_count = 4, field_idx = 4 hoặc field_idx = -1 - M1 Thọ",
      "steps": [
        "Gọi get_token_field_v1 với chỉ số ngoài biên"
      ],
      "expected_result": "Rào chắn phát hiện chỉ số vi phạm, từ chối an toàn trả về -2",
      "priority": "HIGH"
