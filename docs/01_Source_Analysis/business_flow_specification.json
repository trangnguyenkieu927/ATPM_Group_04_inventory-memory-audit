        },
        {
          "name": "quantity",
          "type": "int",
          "offset": 192,
          "size": 4
        },
        {
          "name": "padding_2",
          "type": "padding",
          "offset": 196,
          "size": 4
        },
        {
          "name": "price",
          "type": "double",
          "offset": 200,
          "size": 8
        }
      ]
    },
    "struct_ProductList": {
      "total_size": 24,
