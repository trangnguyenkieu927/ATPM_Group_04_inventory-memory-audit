{
  "name": "quanly_khohang_v0",
  "description": "Quy trình tiếp nhận và xử lý 1 phiếu nhập kho hàng điện máy gồm 3 hành vi: H1 tiếp nhận thông tin phiếu kho (chép mã phiếu vào bộ đệm stack), H2 tạo danh mục lô hàng (cấp phát mảng động các kiện hàng trên heap), H3 tính toán giá trị tồn kho (phép nhân và cộng dồn số nguyên 32-bit, VND). Bản v0 CÀI LỖI CÓ CHỦ ĐÍCH (12 trường hợp rủi ro bộ nhớ/tràn số) để kiểm chứng khả năng phát hiện của mô hình Kripke, công cụ của Thầy và ASan.",
  "requirements": [
    {
      "id": "REQ-01",
      "text": "H1: Hàm đọc mã phiếu kho (doc_ma_phieu) không được ghi vượt biên bộ đệm 16 byte",
      "category": "memory",
      "priority": "HIGH"
    },
    {
      "id": "REQ-02",
      "text": "H1: Mã phiếu hợp lệ không được bị cắt cụt hoặc biến đổi khi lưu vào bộ đệm stack",
      "category": "functional",
      "HIGH": "HIGH"
    },
    {
      "id": "REQ-03",
      "text": "H2: Kết quả cấp phát mảng lô hàng (cap_phat_lo_hang) phải được kiểm tra NULL trước khi sử dụng",
      "category": "memory",
      "priority": "HIGH"
    },
    {
      "id": "REQ-04",
      "text": "H2: Bộ nhớ cấp phát cho danh mục lô hàng phải được giải phóng hoàn toàn khi hủy phiếu hoặc hoàn tất đơn",
      "category": "memory",
      "priority": "HIGH"
    },
    {
      "id": "REQ-05",
      "text": "H2: Con trỏ lô hàng không được phép truy cập sau khi đã gọi free (chống Use-After-Free)",
      "category": "memory",
      "priority": "HIGH"
    },
    {
      "id": "REQ-06",
      "text": "H3: Phép tính giá trị từng dòng lô hàng (đơn giá x số lượng) không được tràn số nguyên 32-bit có dấu",
      "category": "arithmetic",
      "priority": "HIGH"
    },
    {
      "id": "REQ-07",
      "text": "H3: Phép cộng dồn tổng giá trị kho hàng không được vượt trần int32 (tối đa 2.147.483.647 VND)",
      "category": "arithmetic",
      "priority": "HIGH"
    },
    {
      "id": "REQ-08",
      "text": "H3: Số lượng hàng hóa nhập kho phải là số nguyên dương; đơn giá bình quân không được chia cho 0",
      "category": "arithmetic",
      "priority": "HIGH"
    }
  ],
