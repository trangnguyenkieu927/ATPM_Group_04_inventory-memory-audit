  "safety_properties": [
    "AG(!violation)",
    "AG(!buffer_overflow)",
    "AG(!off_by_one)",
    "AG(!null_deref)",
    "AG(!memory_leak)",
    "AG(!use_after_free)",
    "AG(!integer_overflow)",
    "AG(!div_by_zero)",
    "AF(flow_end)",
    "EF(ket_thuc_an_toan)"
  ],
  "arithmetic_checks": [
    {
      "name": "tinh_tien_nhan_lo_hang",
      "variables": "don_gia, so_luong",
      "condition": "don_gia >= 0 and don_gia <= 50000000 and so_luong >= 1 and so_luong <= 1000 and don_gia * so_luong > 2147483647",
      "overflow_expression": "don_gia * so_luong"
    },
    {
      "name": "tong_tien_cong_don_kho",
      "variables": "tong_truoc, tien_lo",
      "condition": "tong_truoc >= 0 and tong_truoc <= 2147483647 and tien_lo >= 0 and tien_lo <= 50000000 and tong_truoc + tien_lo > 2147483647",
      "overflow_expression": "tong_truoc + tien_lo"
    }
  ],
  "test_cases": [
    {
      "id": "TC-01",
      "requirement_ids": [
        "REQ-01",
        "CON-01"
      ],
      "title": "Mã phiếu dài đúng 16 ký tự và 24 ký tự",
      "preconditions": "doc_ma_phieu (v0: buffer 16, strcpy)",
      "steps": [
        "1. Nạp quanly_khohang_v0.json vào công cụ của Thầy",
        "2. Kiểm tra thuộc tính AG(!buffer_overflow) và AG(!off_by_one)",
        "3. Chạy mã C v0 qua ASan"
      ],
      "expected_result": "v0: Vi phạm AG(!buffer_overflow) và AG(!off_by_one), ASan báo stack-buffer-overflow; v1: 0 vi phạm",
      "priority": "HIGH"
    },
    {
      "id": "TC-02",
      "requirement_ids": [
        "REQ-03",
        "REQ-04"
      ],
      "title": "Cấp phát mảng lô hàng và rò rỉ heap khi hủy",
      "preconditions": "cap_phat_lo_hang trên heap",
      "steps": [
        "1. Nạp quanly_khohang_v0.json vào tab kiểm chứng",
        "2. Kiểm tra AG(!memory_leak) và AG(!null_deref)",
        "3. Chạy kịch bản hủy phiếu đột ngột trên mã C"
      ],
      "expected_result": "v0: Vi phạm AG(!memory_leak), ASan phát hiện rò rỉ bộ nhớ; v1: Giải phóng sạch 100%",
      "priority": "HIGH"
    },
    {
      "id": "TC-03",
      "requirement_ids": [
        "REQ-05"
      ],
      "title": "Sử dụng con trỏ lô hàng sau khi giải phóng",
      "preconditions": "truy_cap_lo_hang_sau_free",
      "steps": [
        "1. Kiểm tra AG(!use_after_free)",
        "2. Thực thi mã C sau free()",
        "3. ASan bắt địa chỉ giải phóng"
      ],
      "expected_result": "v0: Vi phạm AG(!use_after_free), ASan báo heap-use-after-free; v1: Gán NULL an toàn",
      "priority": "HIGH"
    },
    {
      "id": "TC-04",
      "requirement_ids": [
        "REQ-06",
        "CON-03",
        "CON-04"
      ],
      "title": "Tổng tiền nhân lô hàng tràn int32",
      "preconditions": "KiemTraSoHoc tinh_tien_nhan_lo_hang",
      "steps": [
        "1. Chạy check_satisfiability() Z3 trên điều kiện tràn",
        "2. Đưa bộ giá trị phản ví dụ vào mã C"
      ],
      "expected_result": "v0: SAT (don_gia=30.000.000, so_luong=100 -> tràn âm tiền); v1: UNSAT do có guard kiểm tra",
