     Trạng thái khởi tạo: ['start']
     Số lượng trạng thái gán nhãn [violation]: 16
     Danh sách trạng thái lỗi: ['h1_tran_1_byte', 'h1_tran_bo_dem', 'h2_doc_rac', 'h2_null', 'h2_sai_kich_thuoc', 'h3_chia_0', 'h3_so_am', 'h3_tran_so', 'h4_nhanh_an', 'h4_tran_token', 'h5_format_string', 'h5_ro_ri', 'h6_con_ma_pin', 'h6_double_free', 'h6_tranh_chap', 'h6_uaf']

