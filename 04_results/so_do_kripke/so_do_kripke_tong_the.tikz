% Mã TikZ mô hình Kripke kết hợp 35 trạng thái (Vẽ chồng v0 và v1)
% Nhóm 04: Kiểm toán an toàn bộ nhớ chương trình quản lý kho
\begin{tikzpicture}[
    node distance=1.8cm,
    every node/.style={font=\footnotesize},
    state/.style={rectangle, rounded corners, draw=black!60, fill=yellow!10, text centered, minimum width=2.8cm, minimum height=0.7cm, inner sep=2pt},
    init_state/.style={state, draw=blue!70, fill=blue!10, line width=1pt},
    safe_state/.style={state, draw=green!70!black, fill=green!10, line width=1pt},
    bad_state/.style={state, draw=red!70!black, fill=red!15, line width=1pt},
    trans_common/.style={->, >=stealth, thick, draw=black!80},
    trans_v0_only/.style={->, >=stealth, dashed, thick, draw=red!80},
    trans_v1_only/.style={->, >=stealth, very thick, draw=green!60!black}
]

    % Các node trạng thái chính trên trục xử lý
    \node[init_state] (start) {start \\ \scriptsize [safe]};
    \node[state, below of=start] (h1_vao) {h1\_vao \\ \scriptsize [receiving]};
    \node[safe_state, below of=h1_vao] (h1_ok) {h1\_ok \\ \scriptsize [input\_ok]};
    \node[bad_state, right=1.5cm of h1_vao] (h1_tran_1_byte) {h1\_tran\_1\_byte \\ \scriptsize [buffer\_overflow, off\_by\_one]};
    \node[bad_state, right=1.5cm of h1_tran_1_byte] (h1_tran_bo_dem) {h1\_tran\_bo\_dem \\ \scriptsize [buffer\_overflow]};
    \node[state, below of=h1_ok] (h2_vao) {h2\_vao \\ \scriptsize [allocating]};
    \node[safe_state, below of=h2_vao] (h2_ok) {h2\_ok \\ \scriptsize [allocated, initialized]};
    \node[bad_state, right=1.5cm of h2_vao] (h2_null) {h2\_null \\ \scriptsize [null\_deref]};
    \node[bad_state, right=1.5cm of h2_null] (h2_sai_kich_thuoc) {h2\_sai\_kich\_thuoc \\ \scriptsize [heap\_overflow]};
    \node[state, below of=h2_ok] (h3_vao) {h3\_vao \\ \scriptsize [computing]};
    \node[safe_state, below of=h3_vao] (h3_ok) {h3\_ok \\ \scriptsize [amount\_ok]};
    \node[bad_state, right=1.5cm of h3_vao] (h3_tran_so) {h3\_tran\_so \\ \scriptsize [int\_overflow]};
    \node[state, below of=h3_ok] (h4_vao) {h4\_vao \\ \scriptsize [token\_received]};
    \node[safe_state, below of=h4_vao] (h4_ok) {h4\_ok \\ \scriptsize [token\_verified]};
    \node[bad_state, right=1.5cm of h4_vao] (h4_tran_token) {h4\_tran\_token \\ \scriptsize [buffer\_overflow]};
    \node[state, below of=h4_ok] (h5_vao) {h5\_vao \\ \scriptsize [logging]};
    \node[safe_state, below of=h5_vao] (h5_ok) {h5\_ok \\ \scriptsize [log\_freed]};
    \node[bad_state, right=1.5cm of h5_vao] (h5_ro_ri) {h5\_ro\_ri \\ \scriptsize [mem\_leak]};
    \node[state, below of=h5_ok] (h6_phien_ranh) {h6\_phien\_ranh \\ \scriptsize [sess\_free]};
    \node[state, below left=1.2cm of h6_phien_ranh] (h6_nhap_giu) {h6\_nhap\_giu \\ \scriptsize [nhap\_locked]};
    \node[state, below right=1.2cm of h6_phien_ranh] (h6_xuat_giu) {h6\_xuat\_giu \\ \scriptsize [xuat\_locked]};
    \node[bad_state, below of=h6_phien_ranh] (h6_tranh_chap) {h6\_tranh\_chap \\ \scriptsize [race, violation]};
    \node[safe_state, below of=h6_tranh_chap] (h6_giai_phong) {h6\_giai\_phong \\ \scriptsize [releasing]};
    \node[safe_state, below left=1.5cm of h6_giai_phong] (ket_thuc_ok) {ket\_thuc\_ok \\ \scriptsize [stock\_done]};
    \node[safe_state, left=2.5cm of h1_ok] (ket_thuc_tu_choi) {ket\_thuc\_tu\_choi \\ \scriptsize [input\_rejected]};
    \node[bad_state, right=5.5cm of h3_ok] (dung_khong_an_toan) {dung\_khong\_an\_toan \\ \scriptsize [unsafe\_halt]};

    % Các cạnh chuyển trạng thái chung giữa v0 và v1
    \draw[trans_common] (start) -- (h1_vao);
    \draw[trans_common] (h1_vao) -- (h1_ok);
    \draw[trans_common] (h1_ok) -- (h2_vao);
    \draw[trans_common] (h2_vao) -- (h2_ok);
    \draw[trans_common] (h2_ok) -- (h3_vao);
    \draw[trans_common] (h3_vao) -- (h3_ok);
    \draw[trans_common] (h3_ok) -- (h4_vao);
    \draw[trans_common] (h4_vao) -- (h4_ok);
    \draw[trans_common] (h4_ok) -- (h5_vao);
    \draw[trans_common] (h5_vao) -- (h5_ok);
    \draw[trans_common] (h5_ok) -- (h6_phien_ranh);
    \draw[trans_common] (h6_nhap_giu) -- (h6_giai_phong);
    \draw[trans_common] (h6_xuat_giu) -- (h6_giai_phong);
    \draw[trans_common] (h6_giai_phong) -- (ket_thuc_ok);

    % Cạnh v0-only: Dẫn sang trạng thái lỗi (nét đứt đỏ)
    \draw[trans_v0_only] (h1_vao) -- (h1_tran_1_byte);
    \draw[trans_v0_only] (h1_vao) -- (h1_tran_bo_dem);
    \draw[trans_v0_only] (h2_vao) -- (h2_null);
    \draw[trans_v0_only] (h2_vao) -- (h2_sai_kich_thuoc);
    \draw[trans_v0_only] (h3_vao) -- (h3_tran_so);
    \draw[trans_v0_only] (h4_vao) -- (h4_tran_token);
    \draw[trans_v0_only] (h5_vao) -- (h5_ro_ri);
    \draw[trans_v0_only] (h6_nhap_giu) -- (h6_tranh_chap);
    \draw[trans_v0_only] (h6_xuat_giu) -- (h6_tranh_chap);
    \draw[trans_v0_only] (h1_tran_1_byte) -- (dung_khong_an_toan);
    \draw[trans_v0_only] (h2_null) -- (dung_khong_an_toan);
    \draw[trans_v0_only] (h3_tran_so) -- (dung_khong_an_toan);

    % Cạnh v1-only: Dẫn về từ chối an toàn (nét đậm xanh)
    \draw[trans_v1_only] (h1_vao) to[bend right=20] (ket_thuc_tu_choi);
    \draw[trans_v1_only] (h2_vao) to[bend right=20] (ket_thuc_tu_choi);
    \draw[trans_v1_only] (h3_vao) to[bend right=20] (ket_thuc_tu_choi);
\end{tikzpicture}